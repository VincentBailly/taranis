+// The CUDA fused GDN decode may store a rollback slot as an update record (gated_delta_net.cu, gdn_rs_load): saved
+// rows must hold the states themselves
+static void rs_materialize(ggml_tensor * s, uint32_t row0, uint32_t n_rows, uint32_t n_planes) {
+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(s->buffer));
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    auto * fn = reg ? (void (*)(ggml_tensor *, int64_t, int64_t, int64_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_gdn_rs_materialize") : nullptr;
+    if (fn) {
+        fn(s, row0, n_rows, n_planes);
+    }
+}
