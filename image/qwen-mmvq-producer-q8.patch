--- a/ggml/src/ggml-cuda/quantize.cu
+++ b/ggml/src/ggml-cuda/quantize.cu
@@ -759,3 +759,44 @@ void quantize_mmq_fp4_cuda(
         quantize_mmq_mxfp4<false><<<num_blocks, block_size, 0, stream>>>(x, ids, vy, ne00, s01, s02, s03, ne0, ne1, ne2, /*n_expert_used=*/0);
     }
 }
+
+block_q8_1 * ggml_cuda_q8_cache_produce(ggml_backend_cuda_context & ctx, const ggml_tensor * t, int last, int64_t ne0) {
+    if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || ne0 % QK8_1 != 0 || ggml_nelements(t) % ne0 != 0) {
+        return nullptr;
+    }
+    // copies whose last reader has run are no longer needed
+    for (size_t k = 0; k < ctx.q8_cache.size(); ) {
+        if (ctx.q8_cache[k].last < ctx.cur_node) {
+            delete ctx.q8_cache[k].buf;
+            ctx.q8_cache.erase(ctx.q8_cache.begin() + k);
+        } else {
+            ++k;
+        }
+    }
+    const int64_t n = ggml_nelements(t);
+    auto * buf = new ggml_cuda_pool_alloc<char>(ctx.pool(), n/ne0 * GGML_PAD(ne0, MATRIX_ROW_PADDING)/QK8_1 * sizeof(block_q8_1));
+    ctx.q8_cache.push_back({ t->view_src ? t->view_src : t, t->view_src ? t->view_offs : 0, n, ne0, last, buf });
+    return (block_q8_1 *) buf->get();
+}
+
+const block_q8_1 * ggml_cuda_q8_cache_lookup(ggml_backend_cuda_context & ctx, const ggml_tensor * t) {
+    if (ctx.q8_cache.empty() || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t)) {
+        return nullptr;
+    }
+    // keyed by tensor, not address: the graph allocator hands a freed activation's memory to later tensors
+    const ggml_tensor * root = t->view_src ? t->view_src : t;
+    const size_t        offs = t->view_src ? t->view_offs : 0;
+    for (const auto & e : ctx.q8_cache) {
+        if (e.t == root && e.offs == offs && e.n == ggml_nelements(t) && e.ne0 == t->ne[0] && ctx.cur_node <= e.last) {
+            return (const block_q8_1 *) e.buf->get();
+        }
+    }
+    return nullptr;
+}
+
+void ggml_cuda_q8_cache_clear(ggml_backend_cuda_context & ctx) {
+    for (auto & e : ctx.q8_cache) {
+        delete e.buf;
+    }
+    ctx.q8_cache.clear();
+}
diff --git a/ggml/src/ggml-cuda/quantize.cuh b/ggml/src/ggml-cuda/quantize.cuh
index 1801da05..fedf0a86 100644
--- a/ggml/src/ggml-cuda/quantize.cuh
+++ b/ggml/src/ggml-cuda/quantize.cuh
@@ -75,3 +75,64 @@ void quantize_scatter_mmq_q8_1_cuda(const float *   x,
