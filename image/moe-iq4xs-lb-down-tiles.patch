+        const int ib = ((ks * 64) % QK_K) / 32 + sub, s = 4 * (il >> 1);
+        w0 = ((r.q.x >> s) & 0x0F0F0F0Fu) | (((r.q.y >> s) & 0x0F0F0F0Fu) << 4);   // byte j: weight j (low), weight 4 + j (high)
+        const uint32_t ls = ((r.sl >> 4 * (ib & 1)) & 0xf) | (((uint32_t) r.sh >> 2 * ib) & 3) << 4;
+        w1 = r.d | (ls << 16);
+    }
+    static __device__ __forceinline__ uint4 decode(const grid_t * g, const uint32_t w0, const uint32_t w1, const int il) {
