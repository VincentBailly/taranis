+// the rows of tokens that a later decode appends: page them in now (same hash as llm_graph_input_ple::set_input,
+// with the predecessors taken from the array; a token without enough of them in the array is skipped)
+void llama_model_qwen4exp::prefetch_tokens(const llama_token * tokens, int32_t n_tokens, int32_t n_new) const {
+    const auto & hp = hparams;
+    const int64_t n_gram = hp.ple_ngram_size, n_heads = hp.ple_n_heads, per_gram = hp.ple_heads_per_ngram;
+    const int64_t eos    = hp.ple_eos_token_id;
+    if (!ple_disk || n_heads <= 0 || n_gram < 2 || n_new <= 0 || n_new > n_tokens) {
+        return;
+    }
+    std::vector<int32_t> idx;
+    std::vector<int64_t> ctx(n_gram);
+    for (int64_t i = n_tokens - n_new; i < n_tokens; ++i) {
+        if (i < n_gram - 1) {
+            continue;
+        }
+        ctx[0] = tokens[i];
+        bool cut = false;
+        for (int64_t s = 1; s < n_gram; ++s) {
+            const llama_token t = cut ? LLAMA_TOKEN_NULL : tokens[i - s];
+            cut = cut || t < 0 || t == eos;
+            ctx[s] = cut ? eos : t;
+        }
+        for (int64_t n = 2; n <= n_gram; ++n) {
+            uint64_t mixed = (uint64_t) ctx[0] * hp.ple_layer_multipliers[0];
+            for (int64_t j = 1; j < n; ++j) {
+                mixed ^= (uint64_t) ctx[j] * hp.ple_layer_multipliers[j];
+            }
+            const int64_t base = (n - 2) * per_gram;
+            for (int64_t g = 0; g < per_gram; ++g) {
+                const int64_t h_i = base + g;
+                idx.push_back((int32_t) (mixed % hp.ple_head_vocab_sizes[h_i] + hp.ple_head_offsets[h_i]));
+            }
+        }
+    }
+    ple_disk->prefetch(idx.data(), idx.size());
+}
