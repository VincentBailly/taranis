+static block_q8_1 * ggml_cuda_q8_for_mmvq_reader(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i_last,
+        const ggml_tensor * t, bool pad = false, int64_t * ne0 = nullptr) {
+    if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || !ctx.stream_context().concurrent_events.empty()) {
+        return nullptr;
+    }
+    const ggml_tensor * root = t->view_src ? t->view_src : t;
+    const size_t        offs = t->view_src ? t->view_offs : 0;
+    int64_t row  = 0;
+    int     last = i_last;
+    for (int k = i_last + 1; k < cgraph->n_nodes && k <= i_last + 16; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
