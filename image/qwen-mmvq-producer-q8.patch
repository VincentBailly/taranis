+
+// 32 consecutive values, one per lane of a full warp, quantized exactly like quantize_q8_1 (same reductions and rounding)
+static __device__ __forceinline__ void quantize_q8_1_warp(const float xi, block_q8_1 * y, const int lane) {
+    float amax = fabsf(xi);
+    float sum  = xi;
+    amax = warp_reduce_max<QK8_1>(amax);
+    sum  = warp_reduce_sum<QK8_1>(sum);
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+    y->qs[lane] = q;
+    if (lane == 0) {
+        y->ds = make_half2(d, sum);
+    }
+}
+
+// element i of a q8_1 copy with rows of ne0 values (ne0 % QK8_1 == 0), written by lane i % QK8_1 of the full warp that holds
+// the 32 values of its block; the warp with the last block of a row also writes the row's zero padding blocks
+static __device__ __forceinline__ void quantize_q8_1_elem(const float v, block_q8_1 * q8, const int64_t i, const int64_t ne0) {
+    const int64_t nb  = ne0 / QK8_1;
+    const int64_t nbp = GGML_PAD(ne0, MATRIX_ROW_PADDING) / QK8_1;
+    const int64_t ib  = (i / QK8_1) % nb;
+    const int     lane = i % QK8_1;
+    block_q8_1 * y = q8 + (i / ne0) * nbp + ib;
+    quantize_q8_1_warp(v, y, lane);
+    if (ib == nb - 1) {
+        for (int64_t b = 1; b < nbp - nb + 1; ++b) {
+            y[b].qs[lane] = 0;
+            if (lane == 0) {
+                y[b].ds = make_half2(0.0f, 0.0f);
+            }
+        }
+    }
+}
+
+// the same for 32 consecutive values held as pairs (v0, v1) = (x[2*p], x[2*p + 1]) by the 16 lanes p of a half warp: the
+// butterfly over elements pairs element j with j^16, j^8, j^4, j^2 (lanes p^8 .. p^1), then j^1 (the other pair member)
+static __device__ __forceinline__ void quantize_q8_1_pairs(const float v0, const float v1, block_q8_1 * y, const int p) {
+    float amax = fmaxf(fabsf(v0), fabsf(v1));
+    float a = v0;
+    float b = v1;
+#pragma unroll
+    for (int offset = 8; offset > 0; offset >>= 1) {
+        amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, offset, 16));
+        a += __shfl_xor_sync(0xffffffff, a, offset, 16);
+        b += __shfl_xor_sync(0xffffffff, b, offset, 16);
+    }
+    const float sum = a + b;
+    const float d   = amax / 127.0f;
+    y->qs[2*p + 0] = amax == 0.0f ? 0 : (int8_t) roundf(v0 / d);
+    y->qs[2*p + 1] = amax == 0.0f ? 0 : (int8_t) roundf(v1 / d);
+    if (p == 0) {
+        y->ds = make_half2(d, sum);
+    }
+}
+
+// The producer of a contiguous F32 activation t can also write the q8_1 copy an MMVQ reading t would quantize: produce()
+// returns the buffer, in the MMVQ's layout for rows of ne0 values (each row padded to MATRIX_ROW_PADDING with zero
+// blocks), and lookup() finds it for an MMVQ reading t as rows of ne0 values up to graph node last.
+block_q8_1 *       ggml_cuda_q8_cache_produce(ggml_backend_cuda_context & ctx, const ggml_tensor * t, int last, int64_t ne0);
+const block_q8_1 * ggml_cuda_q8_cache_lookup(ggml_backend_cuda_context & ctx, const ggml_tensor * t);
+void               ggml_cuda_q8_cache_clear(ggml_backend_cuda_context & ctx);
