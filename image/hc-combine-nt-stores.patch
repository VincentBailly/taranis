+// NT: non-temporal stores, so a big batch's outputs go to memory instead of leaving the caches full of dirty lines
+// that the next kernel has to write back
+template <bool NT>
+__device__ __forceinline__ void hc_store2(uint16_t * p, const float a, const float b) {
+    if constexpr (NT) __builtin_nontemporal_store(hc_pack2(a, b), (uint32_t *) p);
+    else              *(uint32_t *) p = hc_pack2(a, b);
