+            top_k_small_partial<<<dim3(nb, (unsigned) nrows), TOPK_SMALL_THREADS, 0, stream>>>(src0_d, part.get(), (int) ncols, (int) k);
+            top_k_small_merge<<<(unsigned) nrows, TOPK_SMALL_THREADS, 0, stream>>>(part.get(), dst_d, nb, (int) k);
+            CUDA_CHECK(cudaGetLastError());
+            return;
+        }
     }
