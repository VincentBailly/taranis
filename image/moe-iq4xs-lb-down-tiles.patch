+        // H[k] / Lo[k]: high / low bytes of entries 4k..4k+3
+        uint32_t H[4], Lo[4];
+#pragma unroll
+        for (int k = 0; k < 4; ++k) { H[k] = __builtin_amdgcn_perm(T[2*k + 1], T[2*k], 0x07050301u); Lo[k] = __builtin_amdgcn_perm(T[2*k + 1], T[2*k], 0x06040200u); }
