+// IQ3_S: one lane's fields for a whole 256-weight block (4 k-steps) in one burst of loads, two fields per VGPR;
+// re-reading them every k-step thrashes L2 when many tiles are resident. mmb_iq3s_pack4<s> gives pack()'s (w0, w1).
+typedef unsigned short mmb_us2 __attribute__((ext_vector_type(2)));
+struct mmb_iq3s_raw4 { mmb_us2 qs[2], qh[2], sg[2], dsc, sc23; };
+__device__ __forceinline__ void mmb_iq3s_fetch4(const uint8_t * row, const int b, const int sub, const int il, mmb_iq3s_raw4 & r) {
+    const block_iq3_s * x = (const block_iq3_s *) row + b;
+#pragma unroll
+    for (int h = 0; h < 2; ++h) {
+        const int ib0 = 4 * h + sub, ib1 = 4 * h + 2 + sub;
+        r.qs[h].x = *(const uint16_t *)(x->qs + 8 * ib0 + 2 * il); r.qs[h].y = *(const uint16_t *)(x->qs + 8 * ib1 + 2 * il);
+        r.qh[h].x = x->qh[ib0]; r.qh[h].y = x->qh[ib1];
+        r.sg[h].x = x->signs[4 * ib0 + il]; r.sg[h].y = x->signs[4 * ib1 + il];
+    }
+    r.dsc.x = *(const uint16_t *) &x->d; r.dsc.y = *(const uint16_t *)(x->scales); r.sc23.x = *(const uint16_t *)(x->scales + 2);
+}
+template <int s>
+__device__ __forceinline__ void mmb_iq3s_pack4(const mmb_iq3s_raw4 & r, const int sub, uint32_t & w0, uint32_t & w1) {
+    const uint32_t qs = (s & 1) ? r.qs[s / 2].y : r.qs[s / 2].x, qh = (s & 1) ? r.qh[s / 2].y : r.qh[s / 2].x, sg = (s & 1) ? r.sg[s / 2].y : r.sg[s / 2].x;
+    const uint32_t sc = ((s < 2 ? r.dsc.y : r.sc23.x) >> 8 * (s & 1)) & 0xff;
+    w0 = qs | (qh << 16) | (sg << 24);
+    w1 = (uint32_t) r.dsc.x | (((sc >> 4 * sub) & 0xf) << 16);
+}
