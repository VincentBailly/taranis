+// returns false if the batch is not handled here
+static bool mul_mat_vec_kq_columns(
+        const ggml_type type, const void * vx, const void * vy, float * dst, const int64_t ncols_x, const int64_t nrows_x, const int64_t ncols_dst,
+        const int64_t stride_row_x, const int64_t stride_col_y, const int64_t stride_col_dst,
+        const int64_t nchannels_x, const int64_t nchannels_dst, const int64_t stride_channel_x, const int64_t stride_channel_y,
+        const int64_t stride_channel_dst, const int64_t nsamples_x, const int64_t nsamples_dst, const int64_t stride_sample_x,
+        const int64_t stride_sample_y, const int64_t stride_sample_dst, cudaStream_t stream) {
+    const auto & info = ggml_cuda_info().devices[ggml_cuda_get_device()];
+    if (!GGML_CUDA_CC_IS_RDNA3_5(info.cc) || info.warp_size != 32 || ncols_dst < 2 || ncols_dst > 4 || ncols_x % QK_K != 0 ||
+            (type != GGML_TYPE_Q4_K && type != GGML_TYPE_Q5_K && type != GGML_TYPE_Q6_K)) {
+        return false;
+    }
+    // one warp per row: reusing the activations across rows of a warp was slower than more waves in flight
+    constexpr int rows = 1, nwarps = 1;
+    const dim3 block_nums(nrows_x, nchannels_dst, nsamples_dst);
+    const dim3 block_dims(32, nwarps, 1);
+    const uint3 channel_ratio = init_fastdiv_values(nchannels_dst / nchannels_x);
+    const uint3 sample_ratio  = init_fastdiv_values(nsamples_dst / nsamples_x);
+    const auto launch = [&](auto kernel) {
+        kernel<<<block_nums, block_dims, 0, stream>>>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst,
+            channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+    };
+#define KQ_LAUNCH(T) \
+    switch (ncols_dst) { \
+        case 2:  launch(mul_mat_vec_kq_columns_rdna3_5<T, 2, rows>); break; \
+        case 3:  launch(mul_mat_vec_kq_columns_rdna3_5<T, 3, rows>); break; \
+        default: launch(mul_mat_vec_kq_columns_rdna3_5<T, 4, rows>); break; \
+    }
+    switch (type) {
+        case GGML_TYPE_Q4_K: KQ_LAUNCH(GGML_TYPE_Q4_K); break;
+        case GGML_TYPE_Q5_K: KQ_LAUNCH(GGML_TYPE_Q5_K); break;
+        default:             KQ_LAUNCH(GGML_TYPE_Q6_K); break;
+    }
+#undef KQ_LAUNCH
+    return true;
+}
