+#if defined(GGML_USE_HIP)
+// Q4_K/Q5_K/Q6_K x Q8_1 for 2..4 columns on RDNA3.5 (GGML_HINT_EXACT_BATCH unset). Each lane owns 16-byte units of
+// packed weights (32 weights from two 16-weight runs), loads the matching activations of every column once with
+// 16-byte loads and reuses them for c_rows rows, so activation loads no longer dominate the vector memory pipe.
+template <ggml_type type>
+static __device__ __forceinline__ void kq_columns_unit(
+        const void * vx, const int ib, const int u, int4 & qa, int4 & qb, float & fa, float & fb, float & ma, float & mb) {
+    const int l = 16*(u & 1);
+    if constexpr (type == GGML_TYPE_Q6_K) {
+        const block_q6_K * b = (const block_q6_K *) vx + ib;
+        const int h = u >> 2, gg = (u >> 1) & 1;
+        const int4 ql = *(const int4 *) (b->ql + 64*h + 32*gg + l);
+        const int4 qh = *(const int4 *) (b->qh + 32*h + l);
+        const int sa = 2*gg, sb = 2*gg + 4;
+#define KQ6(c) qa.c = __vsubss4((ql.c & 0x0F0F0F0F) | (((qh.c >> sa) & 0x03030303) << 4), 0x20202020); \
+               qb.c = __vsubss4(((ql.c >> 4) & 0x0F0F0F0F) | (((qh.c >> sb) & 0x03030303) << 4), 0x20202020);
+        KQ6(x) KQ6(y) KQ6(z) KQ6(w)
+#undef KQ6
+        const float d = __half2float(b->d);
+        fa = d * b->scales[8*h + 2*gg + (l >> 4)];
+        fb = d * b->scales[8*h + 2*gg + 4 + (l >> 4)];
+        ma = mb = 0.0f;
+    } else {
+        const int j = u >> 1;
+        const uint8_t * scales;
+        const uint8_t * qs;
+        half2 dm;
+        int4 qh = make_int4(0, 0, 0, 0);
+        if constexpr (type == GGML_TYPE_Q5_K) {
+            const block_q5_K * b = (const block_q5_K *) vx + ib;
+            scales = b->scales; qs = b->qs; dm = b->dm;
+            qh = *(const int4 *) (b->qh + l);
+        } else {
+            const block_q4_K * b = (const block_q4_K *) vx + ib;
+            scales = b->scales; qs = b->qs; dm = b->dm;
+        }
+        const int4 q4 = *(const int4 *) (qs + 32*j + l);
+#define KQ45(c) qa.c = (q4.c & 0x0F0F0F0F) | (((qh.c >> (2*j)) & 0x01010101) << 4); \
+                qb.c = ((q4.c >> 4) & 0x0F0F0F0F) | (((qh.c >> (2*j + 1)) & 0x01010101) << 4);
+        KQ45(x) KQ45(y) KQ45(z) KQ45(w)
+#undef KQ45
+        // 6-bit scales and mins of sub-blocks 2j and 2j+1
+        const int s0 = 2*j, s1 = 2*j + 1;
+        int sc0, m0, sc1, m1;
+        if (j < 2) {
+            sc0 = scales[s0] & 63; m0 = scales[s0 + 4] & 63;
+            sc1 = scales[s1] & 63; m1 = scales[s1 + 4] & 63;
+        } else {
+            sc0 = (scales[s0 + 4] & 0xF) | ((scales[s0 - 4] >> 6) << 4); m0 = (scales[s0 + 4] >> 4) | ((scales[s0] >> 6) << 4);
+            sc1 = (scales[s1 + 4] & 0xF) | ((scales[s1 - 4] >> 6) << 4); m1 = (scales[s1 + 4] >> 4) | ((scales[s1] >> 6) << 4);
+        }
+        const float2 dmf = __half22float2(dm);
+        fa = dmf.x * sc0; fb = dmf.x * sc1;
+        // the min term uses the activation sum of the whole 32-weight block: add it once, from the l == 0 unit
+        ma = l == 0 ? dmf.y * m0 : 0.0f;
+        mb = l == 0 ? dmf.y * m1 : 0.0f;
+    }
+}
+
+template <ggml_type type, int c_ncols, int c_rows>
+__launch_bounds__(32, 1)
+static __global__ void mul_mat_vec_kq_columns_rdna3_5(
+        const void * vx_ptr, const void * vy_ptr, float * dst_ptr,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x, const uint32_t stride_col_y,
+        const uint32_t stride_col_dst, const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst, const uint3 sample_ratio,
+        const uint32_t stride_sample_x, const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+    constexpr int warp_size = 32;
+    const int lane = threadIdx.x;
+    const int row0 = (blockIdx.x*blockDim.y + threadIdx.y)*c_rows;
+    if (row0 >= (int) nrows_x) {
+        return;
+    }
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const int ib0 = sample_x*stride_sample_x + channel_x*stride_channel_x + row0*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy_ptr + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+    float * dst = dst_ptr + sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row0;
+
+    const int nunits = 8 * (ncols_x / QK_K);
+    float tmp[c_rows][c_ncols] = {{0.0f}};
+
+    for (int u = lane; u < nunits; u += warp_size) {
+        const int ib = u >> 3, ui = u & 7;
+        const int l  = 16*(ui & 1);
+        // q8_1 blocks of the two 16-weight runs of this unit
+        const int ya = 8*ib + (type == GGML_TYPE_Q6_K ? 4*(ui >> 2) + ((ui >> 1) & 1) : 2*(ui >> 1));
+        const int yb = ya + (type == GGML_TYPE_Q6_K ? 2 : 1);
+        int4 ua[c_ncols], ub[c_ncols];
+        float2 dsa[c_ncols], dsb[c_ncols];
+#pragma unroll
+        for (int c = 0; c < c_ncols; ++c) {
+            const block_q8_1 * yc = y + c*stride_col_y;
+            ua[c]  = *(const int4 *) (yc[ya].qs + l);
+            ub[c]  = *(const int4 *) (yc[yb].qs + l);
+            dsa[c] = __half22float2(yc[ya].ds);
+            dsb[c] = __half22float2(yc[yb].ds);
+        }
+#pragma unroll
+        for (int r = 0; r < c_rows; ++r) {
+            int4 qa, qb;
+            float fa, fb, ma, mb;
+            kq_columns_unit<type>(vx_ptr, ib0 + r*stride_row_x + ib, ui, qa, qb, fa, fb, ma, mb);
+#pragma unroll
+            for (int c = 0; c < c_ncols; ++c) {
+                int sa = ggml_cuda_dp4a(qa.x, ua[c].x, 0);
+                sa = ggml_cuda_dp4a(qa.y, ua[c].y, sa);
+                sa = ggml_cuda_dp4a(qa.z, ua[c].z, sa);
+                sa = ggml_cuda_dp4a(qa.w, ua[c].w, sa);
+                int sb = ggml_cuda_dp4a(qb.x, ub[c].x, 0);
+                sb = ggml_cuda_dp4a(qb.y, ub[c].y, sb);
+                sb = ggml_cuda_dp4a(qb.z, ub[c].z, sb);
+                sb = ggml_cuda_dp4a(qb.w, ub[c].w, sb);
+                tmp[r][c] += fa*dsa[c].x*sa + fb*dsb[c].x*sb;
+                if constexpr (type != GGML_TYPE_Q6_K) {
+                    tmp[r][c] -= ma*dsa[c].y + mb*dsb[c].y;
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int r = 0; r < c_rows; ++r) {
+#pragma unroll
+        for (int c = 0; c < c_ncols; ++c) {
+            const float sum = warp_reduce_sum<warp_size>(tmp[r][c]);
+            if (lane == 0 && row0 + r < (int) nrows_x) {
+                dst[c*stride_col_dst + r] = sum;
+            }
+        }
+    }
+}
