@@ -1637,6 +1719,9 @@ gdn_decode_fused_cuda(const ggml_cuda_gdn_decode_args args) {
             const float kv_col = gdn_warp_reduce_sum<warp_size>(kv_shard);
 
             const float delta_col = fmaf(-g_val, kv_col, v_c[colw + c]) * beta_val;
+            if (rec_slot && lane == 0) {
