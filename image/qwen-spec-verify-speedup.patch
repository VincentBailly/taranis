+#if defined(GGML_USE_HIP)
+// Q8_0 x Q8_1 for 2..4 columns on RDNA3.5 when the batch need not match single columns bit for bit
+// (GGML_HINT_EXACT_BATCH unset). Per-lane 2-byte weight loads and per-column 4-byte activation loads leave the
+// exact kernels bound by the texture-address unit on small matrices. Here each lane reads 16 weight bytes and
+// 16 activation bytes per column with single loads (unaligned loads are fine on AMD), and matrices with few
+// rows split K over c_nwarps warps.
+template <int c_ncols, int c_nwarps>
+__launch_bounds__(c_nwarps * ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q8_0_columns_rdna3_5(
+        const void * vx_ptr, const void * vy_ptr, float * dst_ptr,
+        const uint32_t ncols_x, const uint32_t stride_row_x, const uint32_t stride_col_y,
+        const uint32_t stride_col_dst, const uint3 channel_ratio, const uint32_t stride_channel_x,
+        const uint32_t stride_channel_y, const uint32_t stride_channel_dst, const uint3 sample_ratio,
+        const uint32_t stride_sample_x, const uint32_t stride_sample_y, const uint32_t stride_sample_dst) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int blocks_per_iter = c_nwarps * warp_size / 2;
+
+    const int row  = blockIdx.x;
+    const int lane = threadIdx.x;
+    const int half = lane % 2;
+    const uint32_t channel_dst = blockIdx.y;
+    const uint32_t sample_dst  = blockIdx.z;
+    const uint32_t channel_x   = fastdiv(channel_dst, channel_ratio);
+    const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
+
+    const block_q8_0 * x = (const block_q8_0 *) vx_ptr + sample_x*stride_sample_x + channel_x*stride_channel_x + row*stride_row_x;
+    const block_q8_1 * y = (const block_q8_1 *) vy_ptr + sample_dst*stride_sample_y + channel_dst*stride_channel_y;
+    float * dst = dst_ptr + sample_dst*stride_sample_dst + channel_dst*stride_channel_dst + row;
+
+    const int blocks_per_row_x = ncols_x / QK8_0;
+    float tmp[c_ncols] = {0.0f};
+
+    for (int kb = threadIdx.y*(warp_size/2) + lane/2; kb < blocks_per_row_x; kb += blocks_per_iter) {
+        const int4  xv = *(const int4 *) (x[kb].qs + 16*half);
+        const float dx = __half2float(x[kb].d);
+#pragma unroll
+        for (int j = 0; j < c_ncols; ++j) {
+            const block_q8_1 * by = &y[j*stride_col_y + kb];
+            const int4 yv = *(const int4 *) (by->qs + 16*half);
+            int sumi = ggml_cuda_dp4a(xv.x, yv.x, 0);
+            sumi = ggml_cuda_dp4a(xv.y, yv.y, sumi);
+            sumi = ggml_cuda_dp4a(xv.z, yv.z, sumi);
+            sumi = ggml_cuda_dp4a(xv.w, yv.w, sumi);
+            tmp[j] += dx * __low2float(by->ds) * (float) sumi;
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < c_ncols; ++j) {
+        tmp[j] = warp_reduce_sum<warp_size>(tmp[j]);
+    }
+    if constexpr (c_nwarps > 1) {
+        __shared__ float s_sum[c_nwarps][c_ncols];
+        if (lane == 0) {
+#pragma unroll
+            for (int j = 0; j < c_ncols; ++j) {
+                s_sum[threadIdx.y][j] = tmp[j];
+            }
+        }
+        __syncthreads();
+        if (threadIdx.y != 0) {
+            return;
+        }
+#pragma unroll
+        for (int j = 0; j < c_ncols; ++j) {
+            tmp[j] = 0.0f;
+#pragma unroll
+            for (int w = 0; w < c_nwarps; ++w) {
+                tmp[j] += s_sum[w][j];
+            }
+        }
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int j = 0; j < c_ncols; ++j) {
+            dst[j*stride_col_dst] = tmp[j];
+        }
+    }
+}
+
+// returns false if the batch is not handled here
+static bool mul_mat_vec_q8_0_columns(
+        const void * vx, const void * vy, float * dst, const int64_t ncols_x, const int64_t nrows_x, const int64_t ncols_dst,
+        const int64_t stride_row_x, const int64_t stride_col_y, const int64_t stride_col_dst,
+        const int64_t nchannels_x, const int64_t nchannels_dst, const int64_t stride_channel_x, const int64_t stride_channel_y,
+        const int64_t stride_channel_dst, const int64_t nsamples_x, const int64_t nsamples_dst, const int64_t stride_sample_x,
+        const int64_t stride_sample_y, const int64_t stride_sample_dst, cudaStream_t stream) {
+    const auto & info = ggml_cuda_info().devices[ggml_cuda_get_device()];
+    if (!GGML_CUDA_CC_IS_RDNA3_5(info.cc) || info.warp_size != 32 || ncols_dst < 2 || ncols_dst > 4) {
+        return false;
+    }
+    // fewer than 512 rows: split K over 4 warps to keep the GPU busy
+    const bool split_k = nrows_x*nchannels_dst*nsamples_dst < 512;
+    const dim3 block_nums(nrows_x, nchannels_dst, nsamples_dst);
+    const dim3 block_dims(32, split_k ? 4 : 1, 1);
+    const uint3 channel_ratio = init_fastdiv_values(nchannels_dst / nchannels_x);
+    const uint3 sample_ratio  = init_fastdiv_values(nsamples_dst / nsamples_x);
+    const auto launch = [&](auto kernel) {
+        kernel<<<block_nums, block_dims, 0, stream>>>(vx, vy, dst, ncols_x, stride_row_x, stride_col_y, stride_col_dst,
+            channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+    };
+    switch (ncols_dst) {
+        case 2:  split_k ? launch(mul_mat_vec_q8_0_columns_rdna3_5<2, 4>) : launch(mul_mat_vec_q8_0_columns_rdna3_5<2, 1>); break;
+        case 3:  split_k ? launch(mul_mat_vec_q8_0_columns_rdna3_5<3, 4>) : launch(mul_mat_vec_q8_0_columns_rdna3_5<3, 1>); break;
+        default: split_k ? launch(mul_mat_vec_q8_0_columns_rdna3_5<4, 4>) : launch(mul_mat_vec_q8_0_columns_rdna3_5<4, 1>); break;
+    }
+    return true;
+}
