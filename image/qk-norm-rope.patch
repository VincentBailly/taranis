+// RDNA3.5 prompt path: RMS_NORM -> MUL(w) on narrow rows with the rms_rows_f32 math (one wave per row, same reduction tree),
+// then the multi-section rope that reads it before the store, so the normed rows never round-trip through memory
+static __device__ __forceinline__ float rope_xor_tree(float v) {
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) { v += __shfl_xor_sync(0xffffffff, v, off, 32); }
+    return v;
+}
+
+template <bool has_ff>
+static __global__ void __launch_bounds__(256) rms_rows_rope_multi_f32(const float * x, const float * w, float * dst,
+        const int ncols, const uint3 row_div, const uint3 channel_div, const int64_t total_rows,
+        const int64_t stride_row, const int64_t stride_channel, const int64_t stride_sample, const float eps,
+        const int ne02, const int n_offs, const int32_t * pos, const float freq_scale, const float ext_factor,
+        const float attn_factor, const rope_corr_dims corr_dims, const float theta_scale, const float * freq_factors,
+        const mrope_sections sections, const bool is_imrope) {
+    const int lane = threadIdx.x & 31;
+    const int64_t g = (int64_t) blockIdx.x * 8 + (threadIdx.x >> 5);
+    if (g >= total_rows) return;
+    const uint2 rc = fast_div_modulo(uint32_t(g), row_div);
+    const uint2 cs = fast_div_modulo(rc.x, channel_div);
+    const uint32_t i2 = cs.y;
+    x += cs.x * stride_sample + i2 * stride_channel + rc.y * stride_row;
+    dst += g * ncols;
+    float part[8];
+#pragma unroll
+    for (int wv = 0; wv < 8; ++wv) {
+        const int col = 32 * wv + lane;
+        const float xi = col < ncols ? x[col] : 0.0f;
+        part[wv] = rope_xor_tree(xi * xi);
+    }
+    float v = 0.0f;
+#pragma unroll
+    for (int wv = 0; wv < 8; ++wv) { v = lane == wv ? part[wv] : v; }
+    const float tmp = rope_xor_tree(v);
+    const float mean = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+    float t[8];
+#pragma unroll
+    for (int wv = 0; wv < 8; ++wv) {
+        const int col = 32 * wv + lane;
+        t[wv] = col < ncols ? scale * x[col] * w[col] : 0.0f;
+    }
+    // n_dims == 64: the pair (n_offs + lane, n_offs + 32 + lane) is t[w0], t[w0 + 1] of this lane
+    const int w0 = n_offs / 32, iw = 2 * lane;
+#pragma unroll
+    for (int wv = 0; wv < 7; ++wv) {
+        if (wv != w0) continue;
+        const float theta_base = rope_multi_theta(pos, i2, ne02, iw, theta_scale, sections, is_imrope);
+        const float freq_factor = has_ff ? freq_factors[iw/2] : 1.0f;
+        float cos_theta;
+        float sin_theta;
+        rope_yarn<true>(theta_base/freq_factor, freq_scale, corr_dims, iw, ext_factor, attn_factor, cos_theta, sin_theta);
+        const float x0 = t[wv];
+        const float x1 = t[wv + 1];
+        t[wv]     = x0*cos_theta - x1*sin_theta;
+        t[wv + 1] = x0*sin_theta + x1*cos_theta;
+    }
+#pragma unroll
+    for (int wv = 0; wv < 8; ++wv) {
+        const int col = 32 * wv + lane;
+        if (col < ncols) dst[col] = t[wv];
+    }
+}
