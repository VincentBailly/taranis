+// A few long rows and a small k (e.g. the MTP draft sampler's top-k over the full vocabulary): every thread keeps
+// the TOPK_SMALL_MAXK best (key, column) pairs of its columns, each block takes its k best, one block per row merges
+// them. Same set and order as the stable-tie radix path when its atomic gather runs in column order.
+#define TOPK_SMALL_MAXK    16
+#define TOPK_SMALL_THREADS 256
+
+// larger is better: higher key, then lower column; 0 is never a real entry (~col has the top bit set)
+static __device__ __forceinline__ uint64_t top_k_small_pack(const uint32_t key, const int col) {
+    return ((uint64_t) key << 32) | (uint32_t) ~col;
+}
+
+static __device__ __forceinline__ void top_k_small_insert(uint64_t (&l)[TOPK_SMALL_MAXK], const uint64_t c) {
+    if (c <= l[TOPK_SMALL_MAXK - 1]) {
+        return;
+    }
+#pragma unroll
+    for (int i = TOPK_SMALL_MAXK - 1; i > 0; --i) {
+        l[i] = c < l[i] ? l[i] : (c < l[i - 1] ? c : l[i - 1]);
+    }
+    l[0] = c < l[0] ? l[0] : c;
+}
+
+// k rounds of a block-wide max over the list heads; thread 0 gets the winners in out[0..k)
+static __device__ void top_k_small_select(uint64_t (&l)[TOPK_SMALL_MAXK], const int k, uint64_t * out) {
+    __shared__ uint64_t s_max[TOPK_SMALL_THREADS / 32];
+    const int lane = threadIdx.x % 32, warp = threadIdx.x / 32;
+    for (int r = 0; r < k; ++r) {
+        uint64_t m = l[0];
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            const uint64_t o = __shfl_xor(m, off, 32);
+            m = o > m ? o : m;
+        }
+        if (lane == 0) {
+            s_max[warp] = m;
+        }
+        __syncthreads();
+        m = s_max[0];
+#pragma unroll
+        for (int w = 1; w < TOPK_SMALL_THREADS / 32; ++w) {
+            m = s_max[w] > m ? s_max[w] : m;
+        }
+        __syncthreads();
+        if (m != 0 && l[0] == m) {
+#pragma unroll
+            for (int i = 0; i < TOPK_SMALL_MAXK - 1; ++i) {
+                l[i] = l[i + 1];
+            }
+            l[TOPK_SMALL_MAXK - 1] = 0;
+        }
+        if (threadIdx.x == 0) {
+            out[r] = m;
+        }
+    }
