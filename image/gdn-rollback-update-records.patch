+// Rollback slots of a multi-token decode step: the state after its first token is stored in full, the state after a
+// later token t as the record of its update (the state is fma(g, s, k[row] * delta[col]) of the one before:
+// [mark | t, g, k[S], delta[S], cache row] in place of the head's S*S values), replayed by the reader from the full state
+// t slots further. One state write per step instead of one per token; the replay repeats the same fmaf on the same
+// values (bit-identical). The mark is a NaN pattern, which a state never holds. Only with a single-sequence cache, so a
+// record is never copied to another sequence's row.
+#define GDN_RS_MARK      0x7fd1e700u
+#define GDN_RS_MARK_MASK 0xffffff00u
+
+// a warp's state shard of one head (columns colw.., rows r * warp_size + lane), replaying an update record if there is one
+template <int S, int warp_size, int cols_per_warp, int rows_per_lane>
+static __device__ __forceinline__ void gdn_rs_load(float (&s)[cols_per_warp][rows_per_lane], const float * state_in,
+        const int64_t slot_stride, const int colw, const int lane) {
+    const uint32_t mark = __float_as_uint(state_in[0]);
+    const int      tr   = (mark & GDN_RS_MARK_MASK) == GDN_RS_MARK ? (int) (mark & ~GDN_RS_MARK_MASK) : 0;
+    const float *  base = state_in + tr * slot_stride;
+#pragma unroll
+    for (int c = 0; c < cols_per_warp; c++) {
+#pragma unroll
+        for (int r = 0; r < rows_per_lane; r++) {
+            s[c][r] = base[(colw + c) * S + r * warp_size + lane];
+        }
+    }
+    for (int j = 1; j <= tr; ++j) {
+        const float * rec = state_in + (tr - j) * slot_stride;
+        const float   g   = rec[1];
+        float k[rows_per_lane];
+#pragma unroll
+        for (int r = 0; r < rows_per_lane; r++) {
+            k[r] = rec[2 + r * warp_size + lane];
+        }
+#pragma unroll
+        for (int c = 0; c < cols_per_warp; c++) {
+            const float d = rec[2 + S + colw + c];
+#pragma unroll
+            for (int r = 0; r < rows_per_lane; r++) {
+                s[c][r] = fmaf(g, s[c][r], k[r] * d);
+            }
+        }
+    }
+}
+
+// states gathered from the cache by get_rows, or cache rows in place: replace an update record by the state it stands for
+template <int S>
+__global__ void __launch_bounds__(32 * 16, 1)
+gdn_rs_materialize_cuda(float * state, const float * cache, const int64_t row_stride, const int64_t slot_stride, const int H) {
+    constexpr int warp_size = 32;
+    constexpr int nwarps    = 16;
+    constexpr int rows_per_lane = S / warp_size;
+    constexpr int cols_per_warp = S / nwarps;
+    const int h    = blockIdx.x;
+    const int seq  = blockIdx.y;
+    const int lane = threadIdx.x;
+    const int colw = threadIdx.y * cols_per_warp;
+    float * st = state + ((int64_t) seq * H + h) * S * S;
+    if ((__float_as_uint(st[0]) & GDN_RS_MARK_MASK) != GDN_RS_MARK) {
+        return;
+    }
+    const float * state_in = cache + (int64_t) __float_as_int(st[2 + 2 * S]) * row_stride + (int64_t) h * S * S;
+    float s[cols_per_warp][rows_per_lane];
+    gdn_rs_load<S, warp_size>(s, state_in, slot_stride, colw, lane);
+    __syncthreads(); // in place, the record is read before it is overwritten
+#pragma unroll
+    for (int c = 0; c < cols_per_warp; c++) {
+#pragma unroll
+        for (int r = 0; r < rows_per_lane; r++) {
+            st[(colw + c) * S + r * warp_size + lane] = s[c][r];
+        }
+    }
+}
+
+void ggml_cuda_gdn_rs_materialize(float * cache, int64_t row0, int64_t n_rows, int64_t row_stride, int64_t plane_rows, cudaStream_t stream) {
+    const int H = (int) (row_stride / (128 * 128));
+    gdn_rs_materialize_cuda<128><<<dim3(H, n_rows), dim3(32, 16), 0, stream>>>(cache + row0 * row_stride, cache, row_stride, row_stride * plane_rows, H);
+}
