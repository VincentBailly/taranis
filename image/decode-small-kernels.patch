+
+// __shfl_xor_sync for the butterfly reductions: on RDNA3 (wave32) the constant xor masks 1..16 map to DPP moves and
+// v_permlanex16 instead of a ds_bpermute LDS round trip. Same values as __shfl_xor, which reads 0 from inactive lanes.
+template <typename T>
+static __device__ __forceinline__ T ggml_hip_shfl_xor(const T var, const int lane_mask, const int width) {
+#if defined(__HIP_DEVICE_COMPILE__) && defined(__GFX11__)
+    if constexpr (sizeof(T) == 4 || sizeof(T) == 8) {
+        if (__builtin_amdgcn_wavefrontsize() != 32) {
+            return __shfl_xor(var, lane_mask, width);
+        }
+        if (lane_mask >= width) {
+            return var;   // the source lane is outside the segment: __shfl_xor returns the own value
+        }
+        auto x32 = [lane_mask](const int v) -> int {
+            switch (lane_mask) {
+                case  1: return __builtin_amdgcn_update_dpp(0, v, 0xB1,  0xF, 0xF, true);   // quad_perm:[1,0,3,2]
+                case  2: return __builtin_amdgcn_update_dpp(0, v, 0x4E,  0xF, 0xF, true);   // quad_perm:[2,3,0,1]
+                case  4: return __builtin_amdgcn_update_dpp(0, v, 0x164, 0xF, 0xF, true);   // row_xmask:4
+                case  8: return __builtin_amdgcn_update_dpp(0, v, 0x168, 0xF, 0xF, true);   // row_xmask:8
+                case 16: return __builtin_amdgcn_permlanex16(0, v, 0x76543210, 0xfedcba98, false, false);
+                default: return __shfl_xor(v, lane_mask, 32);
+            }
+        };
+        if constexpr (sizeof(T) == 4) {
+            return __builtin_bit_cast(T, x32(__builtin_bit_cast(int, var)));
+        } else {
+            const int2 v = __builtin_bit_cast(int2, var);
+            return __builtin_bit_cast(T, make_int2(x32(v.x), x32(v.y)));
+        }
+    }
+#endif
+    return __shfl_xor(var, lane_mask, width);
+}
