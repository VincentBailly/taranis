+// one Q8_0 qs word (4 weights, scale d) -> 4 bf16. (q + 128) * d - 128 * d is exact, so this equals d * q,
+// but the unsigned bytes convert with one v_cvt_f32_ubyteN each instead of a sign extend + convert
+__device__ __forceinline__ void mmb_dq_q8_word(const uint32_t v, const float d, uint32_t * out) {
+    const uint32_t u = v ^ 0x80808080u; const float md = -128.0f * d;
+    out[0] = mmb_pack2(fmaf((float)(u & 0xff), d, md), fmaf((float)((u >> 8) & 0xff), d, md));
+    out[1] = mmb_pack2(fmaf((float)((u >> 16) & 0xff), d, md), fmaf((float)(u >> 24), d, md));
+}
