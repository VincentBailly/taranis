+#if defined(GGML_USE_HIP)
+// RDNA3.5 multi-token MoE for 2..4 tokens: tokens that picked the same expert share one block, which decodes each
+// weight once and dots it with every such token's activations (the per-token kernel above re-reads and re-decodes
+// the expert for every token). Same lane layout and accumulation order as mul_mat_vec_q_moe, so results match it.
+// Grid: (row blocks, slot, token); a block whose expert was already picked by an earlier token exits.
+static __device__ __forceinline__ uint32_t moe_iq3s_signed(const uint32_t g, const uint32_t nibble) {
+    // bytes of g are positive; negate byte i when bit i of the nibble is set: ~b + 1 never carries for b >= 1
+    const uint32_t m = ((nibble * 0x00204081u) & 0x01010101u) * 0xFFu;
+    return (g ^ m) + (m & 0x01010101u);
+}
+
+// computes c_rows_per_warp rows of one expert for nm tokens (members)
+template <ggml_type type, bool has_gate, int nm, int c_rows_per_warp>
+static __device__ __forceinline__ void mul_mat_vec_q_moe_shared_rows(
+        const void * vx, const void * vgate, const block_q8_1 * const * y, const uint32_t * s_grid,
+        const int * m_token, const int * m_slot, float * dst, const int kbx_offset, const int row0,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x, const uint32_t stride_col_dst,
+        const uint32_t stride_channel_dst) {
+    constexpr int warp_size = 32;
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int blocks_per_iter = vdr * warp_size / qi;
+    const int lane = threadIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+
+    float tmp[nm][c_rows_per_warp] = {{0.0f}};
+    float tmp_gate[nm][c_rows_per_warp] = {{0.0f}};
+
+    for (int kbx = lane / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int iqs = vdr * (lane % (qi/vdr));
+#pragma unroll
+        for (int i = 0; i < c_rows_per_warp; ++i) {
+#pragma unroll
+            for (int g = 0; g < (has_gate ? 2 : 1); ++g) {
+                const void * vw = g == 0 ? vx : vgate;
+                if constexpr (type == GGML_TYPE_IQ3_S) {
+                    const block_iq3_s * bq = (const block_iq3_s *) vw + kbx_offset + i*stride_row_x + kbx;
+                    const int2 qs_packed = *(const int2 *) (bq->qs + 4*iqs);
+                    const uint8_t * qs = (const uint8_t *) &qs_packed;
+                    const int qh = bq->qh[iqs/2];
+                    const uint32_t signs = *(const uint32_t *) (bq->signs + 4*(iqs/2));
+                    const int ls = 1 + 2*((bq->scales[iqs/4] >> ((iqs << 1) & 0x04)) & 0x0F);
+                    const float dx = __half2float(bq->d);
+                    int w[8];
+#pragma unroll
+                    for (int l0 = 0; l0 < 8; l0 += 2) {
+                        const uint32_t s8 = (signs >> (4*l0)) & 0xFF;
+                        w[l0 + 0] = moe_iq3s_signed(s_grid[qs[l0 + 0] | ((qh << (8 - l0)) & 0x100)], s8 & 0x0F);
+                        w[l0 + 1] = moe_iq3s_signed(s_grid[qs[l0 + 1] | ((qh << (7 - l0)) & 0x100)], s8 >> 4);
+                    }
+#pragma unroll
+                    for (int m = 0; m < nm; ++m) {
+                        const block_q8_1 * by = &y[m][kby + iqs/2];
+                        const int4 u0 = *(const int4 *) (by->qs + 0);
+                        const int4 u1 = *(const int4 *) (by->qs + 16);
+                        int sumi = ggml_cuda_dp4a(w[0], u0.x, 0);
+                        sumi = ggml_cuda_dp4a(w[1], u0.y, sumi);
+                        sumi = ggml_cuda_dp4a(w[2], u0.z, sumi);
+                        sumi = ggml_cuda_dp4a(w[3], u0.w, sumi);
+                        sumi = ggml_cuda_dp4a(w[4], u1.x, sumi);
+                        sumi = ggml_cuda_dp4a(w[5], u1.y, sumi);
+                        sumi = ggml_cuda_dp4a(w[6], u1.z, sumi);
+                        sumi = ggml_cuda_dp4a(w[7], u1.w, sumi);
+                        sumi *= ls;
+                        const float d = dx * __low2float(by->ds);
+                        (g == 0 ? tmp : tmp_gate)[m][i] += d * sumi;
+                    }
+                } else { // GGML_TYPE_IQ4_NL
+                    const block_iq4_nl * bq = (const block_iq4_nl *) vw + kbx_offset + i*stride_row_x + kbx;
+                    const int2 q4 = *(const int2 *) (bq->qs + 4*iqs);
+                    const int2 v0 = get_int_from_table_16(q4.x, kvalues_iq4nl);
+                    const int2 v1 = get_int_from_table_16(q4.y, kvalues_iq4nl);
+                    const float dx = __half2float(bq->d);
+#pragma unroll
+                    for (int m = 0; m < nm; ++m) {
+                        const block_q8_1 * by = &y[m][kby];
+                        const int2 u0 = *(const int2 *) ((const int *) by->qs + iqs);
+                        const int2 u1 = *(const int2 *) ((const int *) by->qs + iqs + 4);
+                        int sumi = ggml_cuda_dp4a(v0.x, u0.x, 0);
+                        sumi = ggml_cuda_dp4a(v0.y, u1.x, sumi);
+                        sumi = ggml_cuda_dp4a(v1.x, u0.y, sumi);
+                        sumi = ggml_cuda_dp4a(v1.y, u1.y, sumi);
+                        const float d = dx * __low2float(by->ds);
+                        (g == 0 ? tmp : tmp_gate)[m][i] += d * sumi;
+                    }
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int m = 0; m < nm; ++m) {
+#pragma unroll
+        for (int i = 0; i < c_rows_per_warp; ++i) {
+            float result = warp_reduce_sum<warp_size>(tmp[m][i]);
+            if constexpr (has_gate) {
+                result *= ggml_cuda_op_silu_single(warp_reduce_sum<warp_size>(tmp_gate[m][i]));
+            }
+            if (lane == 0 && row0 + i < (int) nrows_x) {
+                dst[m_slot[m]*stride_channel_dst + m_token[m]*stride_col_dst + row0 + i] = result;
+            }
+        }
+    }
+}
+
+template <ggml_type type, bool has_gate, int c_ncols, int c_nwarps, int c_rows_per_warp>
+__launch_bounds__(c_nwarps*32, 1)
+static __global__ void mul_mat_vec_q_moe_shared_rdna3_5(
+        const void * vx, const void * vgate, const void * vy, const int32_t * ids, float * dst,
+        const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t nrows_x,
+        const uint32_t stride_row_x, const uint32_t stride_col_y, const uint32_t stride_col_dst,
+        const uint32_t stride_channel_x, const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint32_t n_used, const uint32_t ids_stride) {
+    constexpr int warp_size = 32;
+
+    __shared__ uint32_t s_grid[type == GGML_TYPE_IQ3_S ? 512 : 1];
+    if constexpr (type == GGML_TYPE_IQ3_S) {
+        for (int i = threadIdx.y*warp_size + threadIdx.x; i < 512; i += c_nwarps*warp_size) {
+            s_grid[i] = iq3s_grid[i];
+        }
+    }
+
+    const int lane = threadIdx.x;
+    const uint32_t slot  = blockIdx.y;
+    const uint32_t token = blockIdx.z;
+    const int expert = ids[slot + token*ids_stride];
+
+    // members: this token and every later token that picked the same expert (in the slot where it did)
+    int m_token[c_ncols];
+    int m_slot[c_ncols];
+    int nm = 0;
+#pragma unroll
+    for (int t = 0; t < c_ncols; ++t) {
+        const bool hit = lane < (int) n_used && ids[lane + t*ids_stride] == expert;
+        const uint64_t mask = __ballot(hit);
+        if (t < (int) token && mask != 0) {
+            return; // an earlier token's block computes this expert
+        }
+        if (t >= (int) token && mask != 0) {
+            m_token[nm] = t;
+            m_slot[nm]  = __builtin_ctzll(mask);
+            ++nm;
+        }
+    }
+    __syncthreads();
+
+    const block_q8_1 * y[c_ncols];
+#pragma unroll
+    for (int m = 0; m < c_ncols; ++m) {
+        y[m] = (const block_q8_1 *) vy + fastmodulo(m < nm ? m_slot[m] : 0, nchannels_y)*stride_channel_y + (m < nm ? m_token[m] : 0)*stride_col_y;
+    }
+
+    const int row0 = (blockIdx.x*c_nwarps + threadIdx.y)*c_rows_per_warp;
+    if (row0 >= (int) nrows_x) {
+        return;
+    }
+    const int kbx_offset = expert*stride_channel_x + row0*stride_row_x;
+
+#define MOE_SHARED_ROWS(n) mul_mat_vec_q_moe_shared_rows<type, has_gate, n, c_rows_per_warp>(vx, vgate, y, s_grid, \
+        m_token, m_slot, dst, kbx_offset, row0, ncols_x, nrows_x, stride_row_x, stride_col_dst, stride_channel_dst)
+    switch (nm) {
+        case 1: MOE_SHARED_ROWS(1); break;
+        case 2: if constexpr (c_ncols >= 2) { MOE_SHARED_ROWS(2); } break;
+        case 3: if constexpr (c_ncols >= 3) { MOE_SHARED_ROWS(3); } break;
+        default: if constexpr (c_ncols >= 4) { MOE_SHARED_ROWS(4); } break;
+    }
+#undef MOE_SHARED_ROWS
+}
+
+// returns false if not handled
+template <ggml_type type>
+static bool mul_mat_vec_q_moe_shared_launch(
+        const void * vx, const void * vy, const int32_t * ids, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const uint32_t ncols_x, const uint3 nchannels_y, const uint32_t nrows_x,
+        const uint32_t stride_row_x, const uint32_t stride_col_y, const uint32_t stride_col_dst,
+        const uint32_t stride_channel_x, const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint32_t ncols_dst, const uint32_t ids_stride, const int nchannels_dst, cudaStream_t stream) {
+    if constexpr (type != GGML_TYPE_IQ3_S && type != GGML_TYPE_IQ4_NL) {
+        return false;
+    } else {
+        const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+        const bool gate_only = fusion.x_bias == nullptr && fusion.gate_bias == nullptr && fusion.x_scale == nullptr &&
+            fusion.gate_scale == nullptr && fusion.shared_up == nullptr && (fusion.gate == nullptr || fusion.glu_op == GGML_GLU_OP_SWIGLU);
+        if (!GGML_CUDA_CC_IS_RDNA3_5(cc) || !gate_only || ncols_dst < 2 || ncols_dst > 4 || nchannels_dst > 32 ||
+                ncols_x % ggml_cuda_type_traits<type>::qk != 0) {
