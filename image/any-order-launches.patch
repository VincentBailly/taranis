+// Any-order launches (HIP runtime exporting hipExtSetNextLaunchAnyOrder): while capturing a decode graph, a small
+// MUL_MAT that reads nothing written, and writes nothing accessed, by the nodes evaluated since the last barrier (a
+// launch that waited for all earlier ones) starts its first kernel without waiting for them, so it overlaps them.
+// Pool buffers freed meanwhile are reused only after the next barrier.
+typedef int (*ggml_cuda_any_order_fn)(int);
+static ggml_cuda_any_order_fn ggml_cuda_any_order_setter() {
+    static const ggml_cuda_any_order_fn fn = (ggml_cuda_any_order_fn) dlsym(RTLD_DEFAULT, "hipExtSetNextLaunchAnyOrder");
+    return fn;
+}
+
+// the node captured last on the stream: it changes with every captured launch
+static const void * ggml_cuda_capture_tail(cudaStream_t stream) {
+#if defined(GGML_USE_HIP)
+    hipStreamCaptureStatus status;
+    const hipGraphNode_t * deps = nullptr;
+    size_t n = 0;
+    CUDA_CHECK(hipStreamGetCaptureInfo_v2(stream, &status, nullptr, nullptr, &deps, &n));
+    return n ? deps[n - 1] : nullptr;
+#else
+    GGML_UNUSED(stream);
+    return nullptr;
+#endif
+}
+
+struct ggml_cuda_ao_group {
+    std::vector<std::pair<uintptr_t, uintptr_t>> reads, writes;
+    void clear() { reads.clear(); writes.clear(); }
+};
+
+static std::pair<uintptr_t, uintptr_t> ggml_cuda_ao_span(const ggml_tensor * t) {
+    const uintptr_t a = (uintptr_t) t->data;
+    return { a, a + ggml_nbytes(t) };
+}
+
+static bool ggml_cuda_ao_overlaps(const std::pair<uintptr_t, uintptr_t> & r, const std::vector<std::pair<uintptr_t, uintptr_t>> & v) {
+    for (const auto & x : v) {
+        if (r.first < x.second && x.first < r.second) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// ops that write nothing but dst; anything else may update its sources in place
+static bool ggml_cuda_ao_pure(const ggml_tensor * t) {
+    switch (t->op) {
+        case GGML_OP_MUL_MAT: case GGML_OP_MUL_MAT_ID: case GGML_OP_ADD: case GGML_OP_SUB: case GGML_OP_MUL:
+        case GGML_OP_DIV: case GGML_OP_SCALE: case GGML_OP_UNARY: case GGML_OP_GLU: case GGML_OP_RMS_NORM:
+        case GGML_OP_NORM: case GGML_OP_SOFT_MAX: case GGML_OP_ROPE: case GGML_OP_GET_ROWS: case GGML_OP_CPY:
+        case GGML_OP_CONT: case GGML_OP_DUP: case GGML_OP_SET_ROWS: case GGML_OP_ARGSORT: case GGML_OP_TOP_K:
+        case GGML_OP_SUM_ROWS: case GGML_OP_CONCAT:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static void ggml_cuda_ao_add(ggml_cuda_ao_group & g, const ggml_tensor * t) {
+    if (t->data) {
+        g.writes.push_back(ggml_cuda_ao_span(t));
+    }
+    for (int j = 0; j < GGML_MAX_SRC; ++j) {
+        const ggml_tensor * s = t->src[j];
+        if (s == nullptr || s->data == nullptr) {
+            continue;
+        }
+        g.reads.push_back(ggml_cuda_ao_span(s));
+        if (!ggml_cuda_ao_pure(t)) {
+            g.writes.push_back(ggml_cuda_ao_span(s));
+        }
+    }
+}
+
+static bool ggml_cuda_ao_independent(ggml_backend_cuda_context & ctx, const ggml_tensor * t, const ggml_cuda_ao_group & g) {
+    if (g.writes.empty() || t->op != GGML_OP_MUL_MAT || t->data == nullptr || !t->src[0] || !t->src[1] ||
+            ggml_nrows(t->src[1]) > 8 || ggml_cuda_mmb_claims(ctx, t)) {
+        return false;
+    }
+    const auto w = ggml_cuda_ao_span(t);
+    if (ggml_cuda_ao_overlaps(w, g.writes) || ggml_cuda_ao_overlaps(w, g.reads)) {
+        return false;
+    }
+    for (int j = 0; j < GGML_MAX_SRC; ++j) {
+        const ggml_tensor * s = t->src[j];
+        if (s != nullptr && (s->data == nullptr || ggml_cuda_ao_overlaps(ggml_cuda_ao_span(s), g.writes))) {
+            return false;
+        }
+    }
+    return true;
+}
