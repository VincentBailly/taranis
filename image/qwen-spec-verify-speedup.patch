+// Buffer memsets (e.g. the KV cells wiped by each sequence removal, many small ones per call) are queued on a
+// per-device stream without a host sync each; other work on the device waits for them through an event.
+struct ggml_cuda_pending_memsets {
+    std::mutex   mutex;
+    cudaStream_t stream  = nullptr;
+    cudaEvent_t  event   = nullptr;
+    bool         pending = false;
+};
+
+static ggml_cuda_pending_memsets & ggml_cuda_get_pending_memsets(int device) {
+    static ggml_cuda_pending_memsets pm[GGML_CUDA_MAX_DEVICES];
+    return pm[ggml_cuda_get_physical_device(device)];
+}
+
+static void ggml_cuda_wait_pending_memsets(int device, cudaStream_t stream) {
+    ggml_cuda_pending_memsets & pm = ggml_cuda_get_pending_memsets(device);
+    std::lock_guard<std::mutex> lock(pm.mutex);
+    if (pm.pending) {
+        const cudaError_t err = cudaEventQuery(pm.event);
+        if (err == cudaSuccess) {
+            pm.pending = false; // done, nothing to wait for on any stream
+        } else {
+            if (err != cudaErrorNotReady) {
+                CUDA_CHECK(err);
+            }
+            CUDA_CHECK(cudaStreamWaitEvent(stream, pm.event, 0));
+        }
+    }
+}
