+// IQ4_XS: no grid; a lane fetches the 8 qs bytes holding its 8 weights' nibbles plus d and the sub-block scale bits.
+// Decode as IQ4_NL: fma(kv + 128, d, -128 d) == RN(d * kv) (the -128 d term is exact), d = (float) d16 * (ls - 32)
+// as dequantize_iq4_xs, same RNE -> bit-identical
+template <> struct mmb_lb<32 + GGML_TYPE_IQ4_XS> {
+    static constexpr bool ok = true; using grid_t = uint32_t; static constexpr int N = 1;
+    static __device__ __forceinline__ grid_t entry(const int i) { GGML_UNUSED(i); return 0u; }
+    struct raw { uint2 q; uint16_t d, sh; uint32_t sl; };
+    static __device__ __forceinline__ void fetch(const uint8_t * row, const int ks, const int sub, const int il, raw & r) {
+        const block_iq4_xs * x = (const block_iq4_xs *) row + (ks * 64) / QK_K;
+        const int ib = ((ks * 64) % QK_K) / 32 + sub;
+        r.q = *(const uint2 *) (x->qs + 16 * ib + 8 * (il & 1)); r.d = *(const uint16_t *) &x->d; r.sh = x->scales_h; r.sl = x->scales_l[ib / 2];
